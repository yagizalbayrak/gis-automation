{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ageo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "ageo.interface.api.serve"],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "ageo-demo",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "ageo.interface.api.serve", "--demo"],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
