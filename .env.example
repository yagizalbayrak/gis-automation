# Copy this file to .env, or edit the checked-out .env template locally.
# Never commit a real API key.

# Google AI Studio / Gemini key used by LiteLLM.
GEMINI_API_KEY=

# Enable both LLM paths with Gemini 2.5 Flash.
AGEO_PLANNER_MODEL=gemini/gemini-2.5-flash
AGEO_COMPOSER_MODEL=gemini/gemini-2.5-flash

